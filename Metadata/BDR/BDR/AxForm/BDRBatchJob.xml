        {
            super();

            if (environment.RecId)
            {
                QueryBuildRange range = this.queryBuildDataSource().addRange(fieldNum(BDRBatchJob, EnvironmentId));
                range.value(queryValue(environment.EnvironmentId));
                range.status(RangeStatus::Locked);
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            if (environment.RecId)
            {
                BDRBatchJob.EnvironmentId = environment.EnvironmentId;
            }
        }

]]></Source>
