				<Source><![CDATA[
[Form]
public class BDRCleanupRule extends FormRun
{
    BDREnvironment environment;
}

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (element.args() && element.args().record() && element.args().record().TableId == tableNum(BDREnvironment))
        {
            environment = element.args().record();
        }

        if (!environment.RecId)
        {
            throw error("@BDR:ErrOpenFromEnvironment");
        }

        super();

        element.design().caption(strFmt('%1: %2', element.design().caption(), environment.EnvironmentId));
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateCompanies</Name>
				<Source><![CDATA[
    /// <summary>
    /// Companies can be chosen when the row is saved and not for all companies.
    /// </summary>
    public void updateCompanies()
    {
        boolean canChoose = BDRCleanupRule.canChooseCompanies();

        BDRCleanupRule_ds.object(fieldNum(BDRCleanupRule, AllCompanies)).allowEdit(canChoose);
        Companies.enabled(canChoose && BDRCleanupRule.RecId && !BDRCleanupRule.AllCompanies);

        // Days to keep only apply when older records are deleted.
        BDRCleanupRule_ds.object(fieldNum(BDRCleanupRule, KeepDays)).allowEdit(BDRCleanupRule.CleanupMode == BDRCleanupMode::DeleteOlderThan);

        // Truncate never deletes related records.
        BDRCleanupRule_ds.object(fieldNum(BDRCleanupRule, DeleteRelated)).allowEdit(BDRCleanupRule.CleanupMode != BDRCleanupMode::Truncate);
    }

]]></Source>
			</Method>
		</Methods>
