            if (environment.RecId)
            {
                QueryBuildRange range = this.queryBuildDataSource().addRange(fieldNum(BDRCleanupRule, EnvironmentId));
                range.value(queryValue(environment.EnvironmentId));
                range.status(RangeStatus::Locked);
            }
        }

]]></Source>
