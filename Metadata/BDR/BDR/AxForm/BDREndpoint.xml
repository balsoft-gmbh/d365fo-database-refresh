	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class BDREndpoint extends FormRun
{
    BDREnvironment environment;
}

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (element.args() && element.args().record() && element.args().record().TableId == tableNum(BDREnvironment))
        {
            environment = element.args().record();
        }

        if (!environment.RecId)
        {
            throw error("@BDR:ErrOpenFromEnvironment");
        }

        super();

        element.design().caption(strFmt('%1: %2', element.design().caption(), environment.EnvironmentId));
    }

]]></Source>
			</Method>
			<Method>
				<Name>setEndpointRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Called by the endpoint dialog: shows the new or changed endpoint.
    /// </summary>
    /// <param name = "_endpointRecId">The endpoint.</param>
    public void setEndpointRecId(RecId _endpointRecId)
    {
        BDREndpoint endpoint;

        BDREndpoint_ds.research();

        select firstonly endpoint
            where endpoint.RecId == _endpointRecId;

        if (endpoint.RecId)
        {
            BDREndpoint_ds.positionToRecord(endpoint);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>openEndpointDialog</Name>
				<Source><![CDATA[
    /// <summary>
    /// Opens the endpoint dialog: for a new endpoint of the environment, or to edit an endpoint.
    /// </summary>
    /// <param name = "_record">The environment or the endpoint.</param>
    public void openEndpointDialog(Common _record)
    {
        Args args = new Args();

        args.record(_record);
        args.caller(element);

        new MenuFunction(menuItemDisplayStr(BDREndpointCreate), MenuItemType::Display).run(args);
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateCompanies</Name>
				<Source><![CDATA[
    /// <summary>
    /// Companies can be chosen when the row is saved and not for all companies.
    /// </summary>
    public void updateCompanies()
    {
        boolean canChoose = BDREndpoint.canChooseCompanies();

        BDREndpoint_ds.object(fieldNum(BDREndpoint, AllCompanies)).allowEdit(canChoose);
        EndpointCompanies.enabled(canChoose && BDREndpoint.RecId && !BDREndpoint.AllCompanies);

        EditEndpoint.enabled(BDREndpoint.RecId != 0);
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>BDREndpoint</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            if (environment.RecId)
            {
                QueryBuildRange range = this.queryBuildDataSource().addRange(fieldNum(BDREndpoint, EnvironmentId));
                range.value(queryValue(environment.EnvironmentId));
                range.status(RangeStatus::Locked);
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            if (environment.RecId)
            {
                BDREndpoint.EnvironmentId = environment.EnvironmentId;
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            BDREndpointEvent_ds.executeQuery();
            element.updateCompanies();

            return ret;
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
			<DataSource>
				<Name>BDREndpointEvent</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(BDREndpointEvent, EnvironmentId)).value(
                BDREndpoint.EnvironmentId ? queryValue(BDREndpoint.EnvironmentId) : SysQuery::valueEmptyString());
            SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(BDREndpointEvent, EndpointName)).value(
                BDREndpoint.EndpointName ? queryValue(BDREndpoint.EndpointName) : SysQuery::valueEmptyString());

            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            BDREndpointEvent.EnvironmentId = BDREndpoint.EnvironmentId;
            BDREndpointEvent.EndpointName = BDREndpoint.EndpointName;
        }

]]></Source>
					</Method>
				</Methods>
