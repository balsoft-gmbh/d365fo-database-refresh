						<Name>modified</Name>
						<Source><![CDATA[
        public boolean modified()
        {
            boolean ret = super();

            // Save at once: All companies removes the selected companies and enables Companies.
            BDREndpoint_ds.write();
            BDREndpoint_ds.refresh();
            element.updateCompanies();

            return ret;
        }

]]></Source>
