		<DataControls xmlns="">
			<Control>
				<Name>AddCurrentEnvironment</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            SysEnvironmentid currentId = BDREnvironmentResolver::currentEnvironmentId();
            BDREnvironment existing = BDREnvironment::findBySysEnvironmentId(currentId);

            super();

            if (existing.RecId)
            {
                BDREnvironment_ds.positionToRecord(existing);
                info(strFmt("@BDR:CurrentEnvironmentExists", existing.EnvironmentId));
                return;
            }

            BDREnvironment_ds.create();
            BDREnvironment.SysEnvironmentId = currentId;
            BDREnvironment.EnvironmentMode = EnvironmentMode::TST;
        }

]]></Source>
					</Method>
				</Methods>
