			<Control>
				<Name>TaskSetup</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            BDRTaskType taskType = BDRTaskType::find(BDREnvironmentTask.TaskTypeName);

            super();

            if (!taskType.SetupMenuItem)
            {
                info("@BDR:NoTaskSetup");
                return;
            }

            Args args = new Args();
            args.record(BDREnvironment);
            args.caller(element);

            new MenuFunction(taskType.SetupMenuItem, MenuItemType::Display).run(args);
        }

]]></Source>
					</Method>
				</Methods>
