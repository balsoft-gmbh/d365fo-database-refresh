					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(BDREnvironmentTask, EnvironmentId)).value(
                BDREnvironment.EnvironmentId ? queryValue(BDREnvironment.EnvironmentId) : SysQuery::valueEmptyString());

            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            BDREnvironmentTask.EnvironmentId = BDREnvironment.EnvironmentId;
        }

]]></Source>
