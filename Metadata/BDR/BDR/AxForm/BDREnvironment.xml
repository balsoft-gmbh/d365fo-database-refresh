        public void clicked()
        {
            super();

            if (BDREnvironment.RecId)
            {
                BDREnvironment.addAllTaskTypes();
                BDREnvironmentTask_ds.executeQuery();
            }
        }

]]></Source>
					</Method>
				</Methods>
