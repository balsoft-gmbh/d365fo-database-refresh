			<DataSource>
				<Name>BDRMessageLog</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            this.queryBuildDataSource().addSortField(fieldNum(BDRMessageLog, CreatedDateTime));
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource qbds = this.queryBuildDataSource();

            SysQuery::findOrCreateRange(qbds, fieldNum(BDRMessageLog, JobHistory)).value(queryValue(BDRJobHistory.RecId));

            // The messages of the selected task; the messages of the job itself when it has no task.
            SysQuery::findOrCreateRange(qbds, fieldNum(BDRMessageLog, TaskHistory)).value(
                ShowAllMessages.value() ? '' : queryValue(BDRTaskHistory.RecId));

            super();
        }

]]></Source>
					</Method>
