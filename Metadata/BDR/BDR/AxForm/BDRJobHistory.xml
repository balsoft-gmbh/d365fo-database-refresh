						<Source><![CDATA[
        public void init()
        {
            super();

            this.queryBuildDataSource().addSortField(fieldNum(BDRJobHistory, StartDateTime), SortOrder::Descending);
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            // The grids below follow the selected job, as on the environments form.
            BDRTaskHistory_ds.executeQuery();
            BDRMessageLog_ds.executeQuery();

            return ret;
        }

]]></Source>
