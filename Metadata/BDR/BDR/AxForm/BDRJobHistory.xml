						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            this.queryBuildDataSource().addSortField(fieldNum(BDRTaskHistory, Sequence));
            this.cacheAddMethod(tableMethodStr(BDRTaskHistory, taskLabel));
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(BDRTaskHistory, JobHistory)).value(
                queryValue(BDRJobHistory.RecId));

            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            BDRMessageLog_ds.executeQuery();

            return ret;
        }

]]></Source>
					</Method>
				</Methods>
