				<Source><![CDATA[
[Form]
public class BDRSetupCompany extends FormRun
{
    Common setupRow;
}

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (element.args() && element.args().record())
        {
            setupRow = element.args().record();
        }

        if (!setupRow.RecId || !fieldName2Id(setupRow.TableId, 'AllCompanies') || setupRow.(fieldName2Id(setupRow.TableId, 'AllCompanies')))
        {
            throw error("@BDR:ErrOpenFromSetupRow");
        }

        super();

        element.design().caption(strFmt('%1: %2', element.design().caption(), BDRSetupCompany::rowTitle(setupRow)));
    }

]]></Source>
			</Method>
			<Method>
				<Name>close</Name>
				<Source><![CDATA[
    public void close()
    {
        FormDataSource callerDataSource = setupRow.RecId ? setupRow.dataSource() : null;

        super();

        // The row shows the selected companies.
        if (callerDataSource)
        {
            callerDataSource.research(true);
        }
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>BDRSetupCompany</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            QueryBuildDataSource queryBuildDataSource = this.queryBuildDataSource();
            QueryBuildRange tableRange = queryBuildDataSource.addRange(fieldNum(BDRSetupCompany, RefTableId));
            QueryBuildRange recordRange = queryBuildDataSource.addRange(fieldNum(BDRSetupCompany, RefRecId));

            tableRange.value(queryValue(setupRow.TableId));
            tableRange.status(RangeStatus::Locked);
            recordRange.value(queryValue(setupRow.RecId));
            recordRange.status(RangeStatus::Locked);
            queryBuildDataSource.addSortField(fieldNum(BDRSetupCompany, Company));
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            BDRSetupCompany.RefTableId = setupRow.TableId;
            BDRSetupCompany.RefRecId = setupRow.RecId;
        }

]]></Source>
					</Method>
				</Methods>
