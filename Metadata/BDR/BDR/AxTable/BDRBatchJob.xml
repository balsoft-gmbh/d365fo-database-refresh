				<Name>batchJobCaption</Name>
				<Source><![CDATA[

    public display Description batchJobCaption()
    {
        BatchJob batchJob;

        select firstonly Caption from batchJob
            where batchJob.RecId == this.BatchJob;

        return batchJob.Caption;
    }

]]></Source>
			</Method>
			<Method>
				<Name>batchJobStatus</Name>
				<Source><![CDATA[

    public display BatchStatus batchJobStatus()
    {
        BatchJob batchJob;

        select firstonly Status from batchJob
            where batchJob.RecId == this.BatchJob;

        return batchJob.Status;
    }

]]></Source>
