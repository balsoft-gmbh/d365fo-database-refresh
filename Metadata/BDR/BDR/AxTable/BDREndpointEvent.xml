	<Name>BDREndpointEvent</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// A business event that is activated for an endpoint, in the companies of the endpoint.
/// </summary>
public class BDREndpointEvent extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>eventName</Name>
				<Source><![CDATA[

    public display BusinessEventsNameFormatted eventName()
    {
        BusinessEventsTable businessEventsTable = BusinessEventsTable::find(this.BusinessEventId);
        return businessEventsTable.formattedName();
    }

]]></Source>
			</Method>
			<Method>
				<Name>eventModule</Name>
				<Source><![CDATA[

    public display Description eventModule()
    {
        BusinessEventsTable businessEventsTable = BusinessEventsTable::find(this.BusinessEventId);
        return businessEventsTable.formattedModuleName();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[

    public boolean validateWrite()
    {
        boolean ret = super();
        BDREndpoint bdrEndpoint;
        select firstonly RecId from bdrEndpoint
            where bdrEndpoint.EnvironmentId == this.EnvironmentId
                && bdrEndpoint.EndpointName == this.EndpointName;
        if (!bdrEndpoint.RecId)
        {
            ret = checkFailed("@BDR:ErrOpenFromEndpoint") && ret;
        }
        if (!BusinessEventsTable::find(this.BusinessEventId).RecId)
        {
            ret = checkFailed("@BDR:ErrBusinessEventMissing") && ret;
        }
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
