	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// The tasks that run for an environment, in sequence.
/// </summary>
public class BDREnvironmentTask extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[

    public void initValue()
    {
        super();

        this.IsActive = NoYes::Yes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[

    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        if (_fieldId == fieldNum(BDREnvironmentTask, TaskTypeName) && !this.Sequence)
        {
            this.Sequence = BDRTaskType::find(this.TaskTypeName).DefaultSequence;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>taskLabel</Name>
				<Source><![CDATA[

    public display Description taskLabel()
    {
        return BDRTaskType::find(this.TaskTypeName).taskLabel();
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteOrphans</Name>
				<Source><![CDATA[

    /// <summary>
    /// Deletes tasks whose environment no longer exists, for example after the environment code was changed.
    /// </summary>
    public static void deleteOrphans()
    {
        BDREnvironmentTask environmentTask;
        BDREnvironment environment;

        ttsbegin;

        delete_from environmentTask
            notexists join environment
                where environment.EnvironmentId == environmentTask.EnvironmentId;

        ttscommit;
    }

]]></Source>
			</Method>
		</Methods>
