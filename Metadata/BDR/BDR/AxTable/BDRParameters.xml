	<Name>BDRParameters</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Global parameters of database refresh. Kept in production, so they travel with every copy.
/// </summary>
public class BDRParameters extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[

    public static BDRParameters find(boolean _forUpdate = false)
    {
        BDRParameters parameters;

        parameters.selectForUpdate(_forUpdate);

        select firstonly parameters
            where parameters.Key == 0;

        if (!parameters && !parameters.isTmp())
        {
            Company::createParameter(parameters);
        }

        return parameters;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[

    public void initValue()
    {
        super();

        this.LogRetentionDays = 90;
    }

]]></Source>
			</Method>
			<Method>
				<Name>jobTimeoutHours</Name>
				<Source><![CDATA[

    /// <summary>
    /// Hours a running or scheduled job blocks new jobs of its environment.
    /// </summary>
    /// <returns>The hours from the parameters, 12 when none are set.</returns>
    public int jobTimeoutHours()
    {
        return this.JobTimeoutHours > 0 ? this.JobTimeoutHours : 12;
    }

]]></Source>
			</Method>
		</Methods>
