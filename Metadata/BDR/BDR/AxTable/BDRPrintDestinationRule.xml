<?xml version="1.0" encoding="utf-8"?>
<AxTable xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>BDRPrintDestinationRule</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Print destinations of an environment: the test address that print management e-mail
/// destinations get, and whether electronic reporting e-mail destinations are turned off.
/// </summary>
public class BDRPrintDestinationRule extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[

    public void initValue()
    {
        super();

        this.AllCompanies = NoYes::Yes;
        this.PrintManagement = NoYes::Yes;
        this.ElectronicReporting = NoYes::Yes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[

    public boolean validateWrite()
    {
        boolean ret = super();

        if (!BDRMaskEmail::isValidTestAddress(this.TestAddress, 80))
        {
            ret = checkFailed(strFmt("@BDR:ErrInvalidTestAddress", this.TestAddress)) && ret;
        }

        if (!this.PrintManagement && !this.ElectronicReporting)
        {
            ret = checkFailed("@BDR:ErrPrintNothingSelected") && ret;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>update</Name>
				<Source><![CDATA[

    public void update()
    {
        super();

        // All companies replaces the list of selected companies.
        if (this.AllCompanies)
        {
            BDRSetupCompany::deleteFor(this);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>delete</Name>
				<Source><![CDATA[

    public void delete()
    {
        super();

        BDRSetupCompany::deleteFor(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>companies</Name>
				<Source><![CDATA[

    /// <summary>
    /// The companies this row applies to.
    /// </summary>
    /// <returns>A set of company IDs.</returns>
    public Set companies()
    {
        return BDRSetupCompany::companies(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>companyScope</Name>
				<Source><![CDATA[

    /// <summary>
    /// The selected companies; empty when the row is for all companies.
    /// </summary>
    public display Description companyScope()
    {
        return BDRSetupCompany::scope(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>canChooseCompanies</Name>
				<Source><![CDATA[

    /// <summary>
    /// Customers, vendors, orders and print settings belong to a company, so companies can always be chosen.
    /// </summary>
    public boolean canChooseCompanies()
    {
        return true;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
