	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// The result of one task in a database refresh job.
/// </summary>
public class BDRTaskHistory extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>findScheduled</Name>
				<Source><![CDATA[

    /// <summary>
    /// Finds a task of a job that is waiting for the batch part of the job.
    /// </summary>
    public static BDRTaskHistory findScheduled(RecId _jobHistoryRecId, BDRTaskTypeName _taskTypeName)
    {
        BDRTaskHistory taskHistory;

        select firstonly taskHistory
            where taskHistory.JobHistory == _jobHistoryRecId
                && taskHistory.TaskTypeName == _taskTypeName
                && taskHistory.Status == BDRTaskStatus::Scheduled;

        return taskHistory;
    }

]]></Source>
			</Method>
			<Method>
				<Name>taskLabel</Name>
				<Source><![CDATA[

    public display Description taskLabel()
    {
        return BDRTaskType::find(this.TaskTypeName).taskLabel();
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
