	<Name>BDRTaskType</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Registered task types, filled by <c>BDRTaskTypeRegistration</c> like <c>ArchiveServiceType</c>.
/// </summary>
public class BDRTaskType extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[

    public static BDRTaskType find(BDRTaskTypeName _name, boolean _forUpdate = false)
    {
        BDRTaskType taskType;

        if (_name)
        {
            taskType.selectForUpdate(_forUpdate);

            select firstonly taskType
                where taskType.Name == _name;
        }

        return taskType;
    }

]]></Source>
			</Method>
			<Method>
				<Name>register</Name>
				<Source><![CDATA[

    /// <summary>
    /// Inserts or updates the record of a task type plugin. New task types are enabled.
    /// </summary>
    /// <param name = "_item">The registration item of the plugin.</param>
    /// <param name = "_className">The class implementing the task type.</param>
    public static void register(BDRTaskTypeRegistrationItem _item, ClassName _className)
    {
        BDRTaskType taskType = BDRTaskType::find(_item.parmName(), true);

        ttsbegin;

        taskType.LabelId = _item.parmLabelId();
        taskType.ClassName = _className;
        taskType.RunsInBatch = _item.parmRunsInBatch() ? NoYes::Yes : NoYes::No;
        taskType.SetupMenuItem = _item.parmSetupMenuItem();

        if (taskType.RecId)
        {
            taskType.update();
        }
        else
        {
            taskType.Name = _item.parmName();
            taskType.DefaultSequence = _item.parmDefaultSequence();
            taskType.IsEnabled = NoYes::Yes;
            taskType.insert();
        }

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>taskLabel</Name>
				<Source><![CDATA[

    /// <summary>
    /// The task type in the language of the user.
    /// </summary>
    public display Description taskLabel()
    {
        return this.LabelId ? SysLabel::labelId2String(this.LabelId) : this.Name;
    }

]]></Source>
			</Method>
		</Methods>
