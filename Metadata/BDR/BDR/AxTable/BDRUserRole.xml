	<Name>BDRUserRole</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// A security role a user gets in an environment.
/// </summary>
public class BDRUserRole extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[

    public boolean validateField(FieldId _fieldId)
    {
        boolean ret = super(_fieldId);

        if (_fieldId == fieldNum(BDRUserRole, SecurityRoleName) && this.SecurityRoleName)
        {
            SecurityRole securityRole;

            select firstonly RecId from securityRole
                where securityRole.AotName == this.SecurityRoleName;

            if (!securityRole.RecId)
            {
                ret = checkFailed(strFmt("@BDR:ErrRoleMissing", this.SecurityRoleName));
            }
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>roleName</Name>
				<Source><![CDATA[

    public display SecurityRoleName roleName()
    {
        SecurityRole securityRole;

        select firstonly AotName, Name from securityRole
            where securityRole.AotName == this.SecurityRoleName;

        return securityRole.AotName ? BDRLookup::securityRoleName(securityRole) : "";
    }

]]></Source>
			</Method>
			<Method>
				<Name>userName</Name>
				<Source><![CDATA[

    public display UserName userName()
    {
        UserInfo userInfo;

        select firstonly name from userInfo
            where userInfo.id == this.UserId;

        return userInfo.name;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
