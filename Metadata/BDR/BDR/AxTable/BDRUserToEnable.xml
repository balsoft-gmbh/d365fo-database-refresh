public class BDRUserToEnable extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>userName</Name>
				<Source><![CDATA[

    public display UserName userName()
    {
        UserInfo userInfo;

        select firstonly name from userInfo
            where userInfo.id == this.UserId;

        return userInfo.name;
    }

]]></Source>
