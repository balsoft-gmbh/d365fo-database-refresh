	<Name>BDRWorkflowCancel</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Pending workflows that the CancelWorkflows task cancels in an environment: one workflow
/// configuration (or all when empty) in all or in the selected companies.
/// </summary>
public class BDRWorkflowCancel extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[

    public void initValue()
    {
        super();

        this.AllCompanies = NoYes::Yes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>update</Name>
				<Source><![CDATA[

    public void update()
    {
        super();

        // All companies replaces the list of selected companies.
        if (this.AllCompanies)
        {
            BDRSetupCompany::deleteFor(this);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>delete</Name>
				<Source><![CDATA[

    public void delete()
    {
        super();

        BDRSetupCompany::deleteFor(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>companies</Name>
				<Source><![CDATA[

    /// <summary>
    /// The companies this row applies to.
    /// </summary>
    /// <returns>A set of company IDs.</returns>
    public Set companies()
    {
        return BDRSetupCompany::companies(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>companyScope</Name>
				<Source><![CDATA[

    /// <summary>
    /// The selected companies; empty when the row is for all companies.
    /// </summary>
    public display Description companyScope()
    {
        return BDRSetupCompany::scope(this);
    }

]]></Source>
			</Method>
			<Method>
				<Name>canChooseCompanies</Name>
				<Source><![CDATA[

    /// <summary>
    /// Workflows always belong to a company, so companies can always be chosen.
    /// </summary>
    public boolean canChooseCompanies()
    {
        return true;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
